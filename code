def find_emulator_exe(emu_dir, system):
    hints = EMULATORS[system]["hints"]
    exes = [e for e in find_exes(emu_dir, max_depth=1)
            if any(h in e.lower() for h in hints)]
    return sorted(exes, key=len)


def cue_files(cue):
    folder = os.path.dirname(cue)
    out = []
    try:
        with open(cue, encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if s.upper().startswith("FILE "):
                    rest = s[5:].strip()
                    if rest.startswith('"') and '"' in rest[1:]:
                        name = rest[1:rest.index('"', 1)]
                    else:
                        name = rest.rsplit(" ", 1)[0]
                    out.append(os.path.join(folder, name))
    except OSError:
        pass
    return out


def game_payload(game_path):
    """Return (root_folder, files). files=None means copy the whole root folder."""
    game_path = os.path.normpath(game_path)
    name = os.path.basename(game_path).lower()
    parts = game_path.split(os.sep)
    upper = [p.upper() for p in parts]
    if name == "eboot.bin" and "PS3_GAME" in upper:
        return os.sep.join(parts[:upper.index("PS3_GAME")]), None
    if name.endswith(".xex"):
        return os.path.dirname(game_path), None

    files = {game_path}
    if name.endswith(".cue"):
        files.update(cue_files(game_path))
    elif name.endswith(".m3u"):
        folder = os.path.dirname(game_path)
        with open(game_path, encoding="utf-8", errors="replace") as f:
            for line in f:
                s = line.strip()
                if s and not s.startswith("#"):
                    disc = os.path.join(folder, s)
                    files.add(disc)
                    if disc.lower().endswith(".cue"):
                        files.update(cue_files(disc))
    return os.path.dirname(game_path), sorted(f for f in files if os.path.isfile(f))


