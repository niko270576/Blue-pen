NO_WINDOW = 0x08000000 if IS_WINDOWS else 0  # CREATE_NO_WINDOW

# ============================================================== system helpers


def is_admin():
    try:
        return bool(ctypes.windll.shell32.IsUserAnAdmin())
    except Exception:
        return False


def relaunch_as_admin():
    if getattr(sys, "frozen", False):
        exe, params = sys.executable, ""
    else:
        exe, params = sys.executable, f'"{os.path.abspath(__file__)}"'
    return ctypes.windll.shell32.ShellExecuteW(None, "runas", exe, params, None, 1) > 32


def run_cmd(args):
    r = subprocess.run(
        args, capture_output=True, text=True, errors="replace", creationflags=NO_WINDOW
    )
    return r.returncode, (r.stdout or "").strip(), (r.stderr or "").strip()


def run_powershell(script):
    code, out, err = run_cmd(
        ["powershell", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", script]
    )
    if code != 0:
        raise RuntimeError(err or out or "PowerShell command failed.")
    return out


def ps_quote(s):
    return "'" + s.replace("'", "''") + "'"


def fmt_size(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n} B" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def safe_name(name):
    bad = '<>:"/\\|?*'
    cleaned = "".join("_" if c in bad else c for c in name).strip(" .")
    return cleaned or "Game"


def volume_info(root_path):
    """(label, filesystem) of a drive like 'E:\\'."""
    try:
        label = ctypes.create_unicode_buffer(261)
        fs = ctypes.create_unicode_buffer(261)
        ok = ctypes.windll.kernel32.GetVolumeInformationW(
            ctypes.c_wchar_p(root_path), label, 261, None, None, None, fs, 261
        )
        return (label.value, fs.value) if ok else ("", "")
    except Exception:
        return ("", "")


def list_target_drives():
    """Removable and external drives, never the Windows drive."""
    system_drive = os.environ.get("SystemDrive", "C:").upper()
    drives = []
    for letter in string.ascii_uppercase:
        root_path = f"{letter}:\\"
        if f"{letter}:" == system_drive:
            continue
        dtype = ctypes.windll.kernel32.GetDriveTypeW(root_path)
        if dtype not in (2, 3):  # 2 = removable, 3 = fixed (external SSDs report fixed)
            continue
        try:
            total = shutil.disk_usage(root_path).total
        except OSError:
            continue
        label, fs = volume_info(root_path)
        kind = "USB" if dtype == 2 else "Disk"
        text = f"{root_path}  {label or 'No label'}  ({kind}, {fmt_size(total)}, {fs or '?'})"
        drives.append((text, root_path))
    return drives


# ============================================================== copying


def collect_files(src_root, dst_dir, only=None):
    """List (src, dst, size) to copy. Files already on the target with the same
    size and date are skipped, so re-running resumes an interrupted copy."""
    pairs, errors = [], []
    if only is None:
        sources = (os.path.join(r, f) for r, _, fs in os.walk(src_root) for f in fs)
    else:
        sources = only
    for s in sources:
        d = os.path.join(dst_dir, os.path.relpath(s, src_root))
        try:
            st = os.stat(s)
        except OSError as e:
            errors.append((s, str(e)))
            continue
        try:
            dt = os.stat(d)
            if dt.st_size == st.st_size and abs(dt.st_mtime - st.st_mtime) <= 2:
                continue
        except OSError:
            pass
        pairs.append((s, d, st.st_size))
    return pairs, errors


def preflight(target, pairs):
    total = sum(p[2] for p in pairs)
    free = shutil.disk_usage(target).free
    if total > free:
        raise RuntimeError(
            f"Not enough space on {target}\nNeeded: {fmt_size(total)}   Free: {fmt_size(free)}"
        )
    _, fs = volume_info(target)
    if fs.upper() == "FAT32":
        big = [os.path.basename(p[0]) for p in pairs if p[2] > FAT32_MAX_FILE]
        if big:
            raise RuntimeError(
                "This drive is FAT32, which cannot hold files larger than 4 GB:\n  "
                + "\n  ".join(big[:5])
                + "\n\nFormat the drive as exFAT or NTFS (right-click it in Explorer > Format) and try again."
            )


def copy_with_progress(pairs, on_progress):
    done, errors = 0, []
    for src, dst, _ in pairs:
        try:
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(src, "rb") as fi, open(dst, "wb") as fo:
                while True:
                    buf = fi.read(CHUNK)
                    if not buf:
                        break
                    fo.write(buf)
                    done += len(buf)
                    on_progress(done)
            shutil.copystat(src, dst)
        except OSError as e:
            errors.append((src, str(e)))
    return errors


def error_note(errors):
    if not errors:
        return ""
    s, e = errors[0]
    return f"\n\n{len(errors)} file(s) could not be copied, e.g.\n{os.path.basename(s)}: {e}"


