def write_autorun(target, icon_ref):
    """Windows ignores 'open=' on USB drives since Windows 7, so only the icon and label are set."""
    path = os.path.join(target, "autorun.inf")
    try:
        if os.path.exists(path):
            os.chmod(path, 0o666)
        with open(path, "w", encoding="utf-8", newline="\r\n") as f:
            f.write(f"[autorun]\nicon={icon_ref}\nlabel=BluePen\n")
    except OSError:
        pass


