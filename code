def detect_engine(exe_path, game_dir):
    exe_dir = os.path.dirname(exe_path)
    stem = os.path.splitext(os.path.basename(exe_path))[0]

    def has(*p):
        return os.path.exists(os.path.join(*p))

    if has(exe_dir, "UnityPlayer.dll") or has(exe_dir, stem + "_Data"):
        return "Unity"
    if stem.lower().endswith("-shipping") or has(game_dir, "Engine", "Binaries"):
        return "Unreal Engine"
    if has(exe_dir, "bin", "engine.dll"):
        return "Source"
    if has(exe_dir, stem + ".pck"):
        return "Godot"
    return "Unknown"


def build_gfx_args(engine, preset, compat, res_vars=("%W%", "%H%")):
    """Return (arguments, needs_screen_detection).
    res_vars: how the launcher refers to the detected width/height
    (%W%/%H% in a Windows .bat, ${W}/${H} in a Linux .sh)."""
    t = ENGINES.get(engine)
    if not t:
        return "", False
    parts, auto = [], False
    if preset == GFX_PRESETS[1]:
        parts.append(t["full"].format(w=res_vars[0], h=res_vars[1]))
        auto = True
    elif preset == GFX_PRESETS[2]:
        parts.append(t["window"].format(w=1280, h=720))
    elif preset == GFX_PRESETS[3]:
        parts.append(t["window"].format(w=800, h=600))
    elif preset == GFX_PRESETS[4]:
        parts.append(t["window"].format(w=1280, h=720))
        parts.append(t["low"])
    if compat:
        parts.append(t["compat"])
    return " ".join(p for p in parts if p), auto


SKIP_EXE = ("unins", "crash", "setup", "redist", "dxsetup", "dotnet", "prereq",
            "report", "installer", "updater", "helper")
SKIP_DIRS = {"_commonredist", "redist", "directx", "__installer", "support", "prereqs"}


def find_exes(folder, max_depth=3):
    folder = os.path.normpath(folder)
    base = folder.count(os.sep)
    found = []
    for r, dirs, files in os.walk(folder):
        if r.count(os.sep) - base >= max_depth - 1:
            dirs[:] = []
        dirs[:] = [d for d in dirs if d.lower() not in SKIP_DIRS]
        for f in files:
            fl = f.lower()
            if fl.endswith(".exe") and not any(s in fl for s in SKIP_EXE):
                found.append(os.path.relpath(os.path.join(r, f), folder))
    return found


def pick_best_exe(folder, exes):
    if not exes:
        return ""
    name = os.path.basename(os.path.normpath(folder)).lower().replace(" ", "")

    def score(rel):
        stem = os.path.splitext(os.path.basename(rel))[0].lower().replace(" ", "")
        s = -2 * rel.count(os.sep)
        if stem and (stem in name or name in stem):
            s += 5
        if "launcher" in stem:
            s -= 1
        return s

    return max(exes, key=score)


