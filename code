def do_pc_copy(game_dir, exe_rel, target, engine, compat, extra, icon, preset, play_on):
    name = safe_name(os.path.basename(game_dir))
    dest = os.path.join(target, name)
    for_windows = play_on in (PLAY_ON[0], PLAY_ON[2])
    for_linux = play_on in (PLAY_ON[1], PLAY_ON[2])

    ui(set_status, "Counting files...")
    pairs, errors = collect_files(game_dir, dest)
    preflight(target, pairs)
    ui(set_status, f"Copying {name}...")
    errors += copy_with_progress(pairs, make_progress(sum(p[2] for p in pairs)))

    workdir = os.path.join(name, os.path.dirname(exe_rel))
    note_text = f"{name} | engine: {engine} | graphics: {preset}"
    launchers, args = [], ""
    if for_windows:
        gfx, auto = build_gfx_args(engine, preset, compat)
        args = " ".join(a for a in (gfx, extra) if a)
        write_launcher(
            os.path.join(target, f"Play {name}.bat"),
            workdir_rel=workdir,
            command=f'"{bat(os.path.basename(exe_rel))}" {args}'.strip(),
            auto_res=auto,
            note=note_text,
        )
        launchers.append(f"Windows:  Play {name}.bat")
    if for_linux:
        gfx, auto = build_gfx_args(engine, preset, compat, res_vars=("${W}", "${H}"))
        largs = " ".join(a for a in (gfx, extra) if a)
        args = args or largs
        write_linux_launcher(
            os.path.join(target, f"Play {name}.sh"),
            workdir_rel=workdir,
            exe=os.path.basename(exe_rel),
            args=largs,
            auto_res=auto,
            prefix_id=name,
            note=note_text,
        )
        launchers.append(f"Linux:    Play {name}.sh")

    if icon and os.path.isfile(icon):
        shutil.copy2(icon, os.path.join(dest, "icon.ico"))
        icon_ref = f"{name}\\icon.ico"
    else:
        icon_ref = f"{name}\\{exe_rel},0"
    write_autorun(target, icon_ref)

    with open(os.path.join(dest, "BluePen-info.txt"), "w", encoding="utf-8") as f:
        f.write(f"Game: {name}\nExecutable: {exe_rel}\nEngine: {engine}\n"
                f"Graphics preset: {preset}\nPlays on: {play_on}\nArguments: {args or '(none)'}\n")
        if for_linux:
            f.write("\nOn Linux:\n"
                    f"  Double-click 'Play {name}.sh' (or right-click > Run as program).\n"
                    f"  From a terminal:  bash \"Play {name}.sh\"\n"
                    "  Needs Wine, or better umu-launcher (Proton). The script tells you how to install them.\n"
                    "  Steam alternative: Steam > Add a Non-Steam Game > pick the .exe > "
                    "Properties > Compatibility > force Proton.\n")

    linux_note = ("\n\nOn Linux it runs through Wine/Proton: most games work, "
                  "but games with anti-cheat may not." if for_linux else "")
    ui(finish, True,
       f"{name} is on {target}\n\nTo play, open:\n  " + "\n  ".join(launchers) + "\n\n"
       f"Engine: {engine}\nArguments: {args or '(none)'}"
       + linux_note
       + ("\n\nNote: some games also need Steam/Epic running or their DRM to start." if not errors else "")
       + error_note(errors))


