ui_q = queue.Queue()
busy = False
action_buttons = []
drive_map = {}


def ui(fn, *a):
    ui_q.put((fn, a))


def poll_ui():
    try:
        while True:
            fn, a = ui_q.get_nowait()
            fn(*a)
    except queue.Empty:
        pass
    root.after(50, poll_ui)


def set_status(text, color="blue"):
    lbl_status.config(text=text, fg=color)


def set_progress(value):
    progress_bar["value"] = value


def make_progress(total):
    last = [-1]

    def cb(done):
        pct = int(done * 100 / total) if total else 100
        if pct != last[0]:
            last[0] = pct
            ui(set_progress, pct)

    return cb


def set_busy(flag):
    global busy
    busy = flag
    for b in action_buttons:
        b.config(state="disabled" if flag else "normal")


def finish(ok, message):
    set_busy(False)
    if ok:
        set_progress(100)
        set_status("Done.", "green")
        messagebox.showinfo("Blue Pen", message)
    else:
        set_status("Failed.", "red")
        messagebox.showerror("Blue Pen", message)
    refresh_drives(keep=True)


def start_thread(fn, *args):
    def worker():
        try:
            fn(*args)
        except Exception as e:
            ui(finish, False, str(e))

    threading.Thread(target=worker, daemon=True).start()


def run_task(fn, *args):
    if busy:
        return
    set_busy(True)
    set_progress(0)
    start_thread(fn, *args)


