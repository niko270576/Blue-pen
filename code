def scan_libraries():
    found = []
    for letter in string.ascii_uppercase:
        for sub in LIBRARY_SUBDIRS:
            base = f"{letter}:\\{sub}"
            if not os.path.isdir(base):
                continue
            try:
                entries = list(os.scandir(base))
            except OSError:
                continue
            for e in entries:
                if e.is_dir() and find_exes(e.path, max_depth=3):
                    found.append(e.path)
    return sorted(set(found), key=lambda p: os.path.basename(p).lower())


