def sh_dq(s):
    """Escape text for use inside double quotes in a shell script."""
    s = s.replace("\\", "/")
    for ch in ('"', "$", "`"):
        s = s.replace(ch, "\\" + ch)
    return s


def write_linux_launcher(path, workdir_rel, exe, args, auto_res=False, prefix_id="game", note=""):
    """Linux launcher: runs the Windows .exe with Proton (umu-run) if installed, otherwise Wine."""
    workdir = sh_dq(workdir_rel).rstrip("/")
    exe_q = sh_dq(exe)
    lines = [
        "#!/usr/bin/env bash",
        f"# Blue Pen launcher for Linux - {note.replace(chr(10), ' ')}",
        "# Runs the Windows game with Proton (umu-run) if installed, otherwise with Wine.",
        'HERE="$(dirname "$(readlink -f "$0")")"',
        f'cd "$HERE/{workdir}" || {{ echo "Folder not found: {workdir}"; read -r _; exit 1; }}',
    ]
    if auto_res:
        lines += [
            "# Detect the screen resolution of the PC this runs on",
            "W=1280; H=720",
            "if command -v xrandr >/dev/null 2>&1; then",
            "  RES=$(xrandr --current 2>/dev/null | awk '/\\*/ {print $1; exit}')",
            '  case "$RES" in *x*) W="${RES%x*}"; H="${RES#*x}";; esac',
            "fi",
        ]
    lines += LINUX_BOOTSTRAP + [
        "# The Wine prefix lives in your home folder: USB file systems can't hold one.",
        f'BASE="$BP_HOME/{sh_dq(prefix_id)}"',
        "if find_umu || install_umu; then",
        '  export WINEPREFIX="$BASE-proton" GAMEID=umu-default PROTONPATH="${PROTONPATH:-GE-Proton}"',
        '  mkdir -p "$WINEPREFIX"',
        f'  exec "$UMU" "{exe_q}" {args}'.rstrip(),
        "elif command -v wine >/dev/null 2>&1; then",
        '  export WINEPREFIX="$BASE-wine"',
        '  mkdir -p "$WINEPREFIX"',
        f'  exec wine "{exe_q}" {args}'.rstrip(),
        "fi",
        f'MSG="{WINE_HELP}"',
        "if command -v zenity >/dev/null 2>&1; then zenity --error --no-wrap --text=\"$(printf '%b' \"$MSG\")\";",
        "elif command -v kdialog >/dev/null 2>&1; then kdialog --error \"$(printf '%b' \"$MSG\")\";",
        "else printf '%b\\n' \"$MSG\"; read -r _; fi",
        "exit 1",
    ]
    with open(path, "w", encoding="utf-8", newline="\n") as f:
