              "plays on any Windows PC. Use your own game dumps and BIOS.")
    ttk.Label(tab, text="Console:").pack(anchor="w", pady=(8, 0))
    con_system = ttk.Combobox(tab, values=list(EMULATORS), state="readonly")
    con_system.pack(fill="x")
    con_system.current(1)
    con_system.bind("<<ComboboxSelected>>", on_system_changed)
    con_emu = path_row(tab, "Emulator folder (portable version recommended):",
                       lambda e: browse_dir(e, "Select emulator folder", on_emu_folder))
    ttk.Label(tab, text="Emulator executable:").pack(anchor="w", pady=(8, 0))
    con_emu_exe = ttk.Combobox(tab)
    con_emu_exe.pack(fill="x")
    con_game = path_row(tab, "Game file (PS3: EBOOT.BIN inside PS3_GAME\\USRDIR):", browse_game_file)
    con_fullscreen = tk.BooleanVar(value=True)
    ttk.Checkbutton(tab, text="Start in full screen", variable=con_fullscreen).pack(anchor="w", pady=(6, 0))
    note(tab, "PS4, PS5 and Xbox One/Series aren't offered: there is no emulator that runs them reliably.")
    action_button(tab, "Copy emulator + game to USB", start_console_copy)

    # ---- Bootable
    tab = ttk.Frame(nb, padding=10)
    nb.add(tab, text="Bootable USB")
    note(tab, "Makes a real UEFI-bootable USB from an ISO (Windows 10/11 installer, Linux, rescue disks). "
              "Large Windows images are split automatically to fit FAT32.\n\n"
              "The whole USB stick is ERASED. Needs administrator rights.", "#333")
    boot_iso = path_row(tab, "ISO file:", lambda e: browse_file(e, "Select ISO", [("ISO image", "*.iso")]))
    action_button(tab, "Create bootable USB (erases the drive)", start_bootable)

    # ---- Burn
    tab = ttk.Frame(nb, padding=10)
    nb.add(tab, text="Burn Disc")
    burn_iso = path_row(tab, "ISO file:",
                        lambda e: browse_file(e, "Select ISO", [("ISO image", "*.iso")], on_burn_iso))
    lbl_iso_boot = note(tab, "")
    note(tab, "Whether a disc boots depends only on the ISO itself; Blue Pen tells you above.")
    action_button(tab, "Open Windows Disc Burner", burn_disc)

    # ---- Progress
    bottom = ttk.Frame(root, padding=(12, 0, 12, 10))
    bottom.pack(fill="x")
    progress_bar = ttk.Progressbar(bottom, mode="determinate", maximum=100)
    progress_bar.pack(fill="x")
    lbl_status = tk.Label(bottom, text="Ready.", fg="gray", anchor="w")
    lbl_status.pack(fill="x", pady=(4, 0))

    refresh_drives()
    root.after(50, poll_ui)
    root.mainloop()
