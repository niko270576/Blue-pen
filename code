def iso_is_bootable(path):
    """Look for an El Torito boot record (what makes a CD/DVD/ISO bootable)."""
    try:
        with open(path, "rb") as f:
            for sector in range(16, 32):
                f.seek(sector * 2048)
                d = f.read(2048)
                if len(d) < 30 or d[1:6] != b"CD001":
                    break
                if d[0] == 0 and d[7:16] == b"EL TORITO":
                    return True
                if d[0] == 255:
                    break
    except OSError:
        return None
    return False


