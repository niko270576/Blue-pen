def do_console_copy(system, emu_dir, emu_exe, game, fullscreen, target):
    spec = EMULATORS[system]
    emu_name = safe_name(os.path.basename(emu_dir))
    emu_dest = os.path.join(target, "Emulators", emu_name)

    root_dir, files = game_payload(game)
    if files is None:
        folder = safe_name(os.path.basename(root_dir))
        game_dest = os.path.join(target, "Games", spec["short"], folder)
        gpairs, gerr = collect_files(root_dir, game_dest)
        launch_rel = os.path.join("Games", spec["short"], folder, os.path.relpath(game, root_dir))
    else:
        game_dest = os.path.join(target, "Games", spec["short"])
        gpairs, gerr = collect_files(root_dir, game_dest, files)
        launch_rel = os.path.join("Games", spec["short"], os.path.basename(game))

    ui(set_status, "Counting files...")
    epairs, eerr = collect_files(emu_dir, emu_dest)
    pairs = epairs + gpairs
    preflight(target, pairs)
    ui(set_status, f"Copying emulator and game...")
    errors = eerr + gerr + copy_with_progress(pairs, make_progress(sum(p[2] for p in pairs)))

    for marker in spec["portable"]:
        p = os.path.join(emu_dest, marker)
        if not os.path.exists(p):
            open(p, "w").close()

    warnings = []
    if spec["bios"]:
        bios = os.path.join(emu_dest, spec["bios"])
        if not (os.path.isdir(bios) and os.listdir(bios)):
            warnings.append(f"No BIOS found. Copy your own {spec['short']} BIOS file into:\n  {bios}")
    if spec["short"] == "PS3" and not os.path.isdir(os.path.join(emu_dest, "dev_flash", "sys")):
        warnings.append("PS3 firmware isn't installed in this RPCS3 folder. "
                        "Install it in RPCS3 (File > Install Firmware) and copy again.")

    stem = safe_name(os.path.splitext(os.path.basename(
        root_dir if files is None else game))[0])
    args = spec["args"].format(fs=spec["fs"] if fullscreen else "",
                               game="%~dp0" + bat(launch_rel))
    launcher_name = f"Play {stem} ({spec['short']}).bat"
    write_launcher(
        os.path.join(target, launcher_name),
        workdir_rel=os.path.join("Emulators", emu_name, os.path.dirname(emu_exe)),
        command=f'"{bat(os.path.basename(emu_exe))}" {args}',
        note=f"{system}",
    )

    ui(finish, True,
       f"Done. To play on any PC, open:\n  {launcher_name}"
       + ("\n\n" + "\n\n".join(warnings) if warnings else "")
       + error_note(errors))


