def bootable_prepare(iso, target):
    ui(set_status, "Checking the USB drive...")
    info = json.loads(run_powershell(DISK_INFO_PS.replace("__L__", target[0])))
    if info["IsBoot"] or info["IsSystem"]:
        raise RuntimeError("That drive holds Windows. Refusing to erase it.")
    if info["Bus"].upper() != "USB":
        raise RuntimeError(f"{target} is not a USB drive (bus: {info['Bus']}).\n"
                           "For safety, Blue Pen only erases USB drives.")

    ui(set_status, "Opening the ISO...")
    mine, src = mount_iso(iso)
    try:
        files, total, big = [], 0, []
        for r, _, fs in os.walk(src):
            for f in fs:
                p = os.path.join(r, f)
                size = os.path.getsize(p)
                rel = os.path.relpath(p, src)
                files.append((p, rel, size))
                total += size
                if size > FAT32_MAX_FILE:
                    big.append(rel)
        wim = os.path.join("sources", "install.wim").lower()
        split = any(b.lower() == wim for b in big)
        other_big = [b for b in big if b.lower() != wim]
        if other_big:
            raise RuntimeError("This ISO contains files over 4 GB that FAT32 can't hold:\n  "
                               + "\n  ".join(other_big[:5]))
        usable = min(info["Size"], 32 * 1024**3)
        if total + 64 * 1024**2 > usable:
            raise RuntimeError(f"The USB is too small. Needed: {fmt_size(total)}, usable: {fmt_size(usable)}")
        has_efi = os.path.isfile(os.path.join(src, "efi", "boot", "bootx64.efi"))
    except Exception:
        if mine:
            unmount_iso(iso)
        raise
    ui(bootable_confirm, dict(iso=iso, target=target, info=info, mine=mine, src=src,
                              files=files, split=split, has_efi=has_efi, wim=wim))


def bootable_confirm(job):
    info = job["info"]
    msg = (f"ALL DATA on this USB will be ERASED:\n\n  {info['Name']}  ({fmt_size(info['Size'])})"
           f"  -  {job['target']}\n\n"
           "It will be formatted FAT32 and made UEFI-bootable.")
    if info["Size"] > 32 * 1024**3:
        msg += "\n(Windows can only format 32 GB as FAT32, so a 32 GB partition will be used.)"
    if job["split"]:
        msg += "\n\nWindows ISO detected: install.wim will be split to fit FAT32."
    if not job["has_efi"]:
        msg += "\n\nWARNING: this ISO has no UEFI boot file (efi\\boot\\bootx64.efi). The USB may not boot."
    if messagebox.askyesno("Erase USB?", msg + "\n\nContinue?", icon="warning"):
        start_thread(bootable_write, job)
    else:
        if job["mine"]:
            threading.Thread(target=unmount_iso, args=(job["iso"],), daemon=True).start()
        set_busy(False)
        set_status("Cancelled.", "gray")


def bootable_write(job):
    target, src = job["target"], job["src"]
    try:
        ui(set_status, f"Erasing and formatting {target}...")
        run_powershell(FORMAT_PS.replace("__N__", str(job["info"]["Number"]))
                       .replace("__L__", target[0]))
        pairs = [(s, os.path.join(target, rel), size) for s, rel, size in job["files"]
                 if not (job["split"] and rel.lower() == job["wim"])]
        ui(set_status, "Copying boot and setup files...")
        errors = copy_with_progress(pairs, make_progress(sum(p[2] for p in pairs)))
        if errors:
            raise RuntimeError("Copy failed, the USB is not usable." + error_note(errors))
        if job["split"]:
            ui(set_status, "Splitting install.wim for FAT32 (can take 10+ minutes)...")
            code, out, err = run_cmd([
                "dism", "/Split-Image",
                f"/ImageFile:{os.path.join(src, 'sources', 'install.wim')}",
                f"/SWMFile:{os.path.join(target, 'sources', 'install.swm')}",
                "/FileSize:3800"])
            if code != 0:
                raise RuntimeError("DISM failed:\n" + (out or err)[-800:])
    finally:
        if job["mine"]:
            unmount_iso(job["iso"])
    ui(finish, True,
       f"Bootable USB ready on {target}\n\nBoot the PC from it with the boot menu key "
       "(usually F12, F11, F8 or Esc). It boots in UEFI mode.")


